# Copy this file to .env and adjust values before running `docker compose up`.
# All values below have safe local-dev defaults baked into docker-compose.yml;
# only GEMINI_API_KEY and the Postgres password should be changed for a
# real deployment.

# --- PostgreSQL (used by docker-compose; not needed for local SQLite dev) ---
POSTGRES_USER=payverify
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payverify

# --- Backend ---
# Gemini key for real AI explanations. Leave blank to use the
# deterministic StubExplanationProvider fallback (fully functional without it).
GEMINI_API_KEY=

# Comma-separated list of allowed browser origins for CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# --- Frontend ---
# Baked into the client bundle at Docker build time (see frontend/Dockerfile).
# Point this at the nginx entrypoint (http://localhost:8080) when running via
# docker compose, or at the backend directly (http://localhost:8000) for
# non-Docker local development (frontend/.env.local already sets this).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
